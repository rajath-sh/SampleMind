graph ER { graph [rankdir=LR, splines=spline, nodesep=0.4, ranksep=0.85, pad=0.45, bgcolor="white", fontname="Times New Roman", fontsize=24, labelloc=t, label="SampleMind | 11-table Chen ER model\nAt most 4 entity attributes (including derived); primary keys and essential foreign keys\nUnderlined: PK | (FK): foreign key | dashed ellipse: derived | double line: total participation"]; node [fontname="Times New Roman",fontsize=16,color="black",fillcolor="white",style=solid,penwidth=1]; edge [fontname="Times New Roman",fontsize=14,color="black",penwidth=1];subgraph "cluster_AppUser" { style=invis; margin=18; "AppUser" [shape=box,label="AppUser"];"AppUser.user_id" [shape=ellipse,label=<<U>user_id</U>>]; "AppUser" -- "AppUser.user_id";"AppUser.display_name" [shape=ellipse,label=<display_name>]; "AppUser" -- "AppUser.display_name";"AppUser.role" [shape=ellipse,label=<role>]; "AppUser" -- "AppUser.role";}subgraph "cluster_Sample" { style=invis; margin=18; "Sample" [shape=box,label="Sample"];"Sample.sample_id" [shape=ellipse,label=<<U>sample_id</U>>]; "Sample" -- "Sample.sample_id";"Sample.sample_type_id" [shape=ellipse,label=<sample_type_id (FK)>]; "Sample" -- "Sample.sample_type_id";"Sample.current_storage_location_id" [shape=ellipse,label=<current_storage_location_id (FK)>]; "Sample" -- "Sample.current_storage_location_id";}subgraph "cluster_SampleType" { style=invis; margin=18; "SampleType" [shape=box,label="SampleType"];"SampleType.sample_type_id" [shape=ellipse,label=<<U>sample_type_id</U>>]; "SampleType" -- "SampleType.sample_type_id";"SampleType.type_code" [shape=ellipse,label=<type_code>]; "SampleType" -- "SampleType.type_code";"SampleType.type_name" [shape=ellipse,label=<type_name>]; "SampleType" -- "SampleType.type_name";}subgraph "cluster_StorageLocation" { style=invis; margin=18; "StorageLocation" [shape=box,label="StorageLocation"];"StorageLocation.storage_location_id" [shape=ellipse,label=<<U>storage_location_id</U>>]; "StorageLocation" -- "StorageLocation.sto