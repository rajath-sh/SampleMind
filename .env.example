# ==============================================================================
# SampleMind Environment Configuration
# ==============================================================================

# Application Environment
APP_NAME=SampleMind
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=False

# ==============================================================================
# SINGLE-VARIABLE DATABASE SWITCH:
# USE_SQLITE=True  -> Uses instant zero-setup local SQLite (samplemind.db)
# USE_SQLITE=False -> Uses PostgreSQL (requires local or docker postgres)
# ==============================================================================
USE_SQLITE=True

# SQLite Database Location
SQLITE_URL=sqlite:///samplemind.db

# Database Configuration (PostgreSQL 15 / 16) - used when USE_SQLITE=False
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/samplemind_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=samplemind_db
DB_USER=postgres
DB_PASSWORD=postgres

# Security & Authentication (JWT)
# JWT_SECRET_KEY=generate-a-unique-secret-to-preserve-sessions-across-restarts
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Embedded NoSQL database
DOCUMENT_DB_PATH=.runtime/evidence.json

# Optional Gemini chat. Keep credentials server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
