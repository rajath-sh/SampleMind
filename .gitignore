# Ignore Markdown documentation files (specifications/plans/prompts)
*.md
!README.md
!IMPLEMENTATION_PLAN.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment variables & secrets (CRITICAL for private/public safety)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# SQLite / Database artifacts & logs
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
pgdata/

# Machine Learning artifacts & heavy training data
ml/artifacts/*.joblib
ml/artifacts/*.pkl
!ml/artifacts/.gitkeep
data/*.csv
*.h5
*.onnx

# Node & Frontend dependencies & build outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage & caches
.pytest_cache/
.coverage
htmlcov/
*.log

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Local project runtime
.runtime/
.npm-cache/
